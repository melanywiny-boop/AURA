<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calculadora de Inversión</title>

<style>

body{
font-family: Arial, sans-serif;
background:#f5f6fa;
display:flex;
justify-content:center;
align-items:center;
height:100vh;
margin:0;
}

.calculadora{
background:white;
padding:30px;
border-radius:10px;
box-shadow:0 5px 20px rgba(0,0,0,0.15);
width:350px;
}

h2{
text-align:center;
margin-bottom:20px;
}

label{
font-weight:bold;
font-size:14px;
}

input{
width:100%;
padding:10px;
margin:10px 0 20px;
border-radius:6px;
border:1px solid #ccc;
}

button{
width:100%;
padding:12px;
background:#007bff;
color:white;
border:none;
border-radius:6px;
font-size:16px;
cursor:pointer;
}

button:hover{
background:#0056b3;
}

.resultado{
margin-top:20px;
font-size:18px;
font-weight:bold;
text-align:center;
}

</style>
</head>

<body>

<div class="calculadora">

<h2>Calculadora</h2>

<label>Precio del inmueble ($)</label>
<input type="number" id="precio">

<label>Inicial (%)</label>
<input type="number" id="inicial">

<label>Años de financiamiento</label>
<input type="number" id="anos">

<button onclick="calcular()">Calcular</button>

<div class="resultado" id="resultado"></div>

</div>

<script>

function calcular(){

let precio = document.getElementById("precio").value;
let inicial = document.getElementById("inicial").value;
let anos = document.getElementById("anos").value;

let inicialMonto = precio * (inicial/100);
let financiamiento = precio - inicialMonto;

let cuota = financiamiento / (anos * 12);

document.getElementById("resultado").innerHTML =
`Inicial: $${inicialMonto.toFixed(2)} <br>
Cuota mensual aprox: $${cuota.toFixed(2)}`;

}

</script>

</body>
</html>
